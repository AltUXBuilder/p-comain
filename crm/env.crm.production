# ─────────────────────────────────────────────────────────────────────────────
# CRM .env.production template
# Copy to public_html/crm/.env and fill in real values
# ─────────────────────────────────────────────────────────────────────────────

APP_NAME="Prescribe & Co CRM"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://crm.prescribeandco.co.uk
APP_TIMEZONE=Europe/London

LOG_CHANNEL=stack
LOG_LEVEL=warning

# ── Shared Database (same credentials as website) ────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pando_production
DB_USERNAME=pando_user
DB_PASSWORD=

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_PREFIX=crm_

# ── Cache / Session / Queue ───────────────────────────────────────────────────
CACHE_STORE=redis
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=strict
QUEUE_CONNECTION=redis

# ── Mail (SendGrid) ───────────────────────────────────────────────────────────
MAIL_MAILER=sendgrid
SENDGRID_API_KEY=
MAIL_FROM_ADDRESS=pharmacy@prescribeandco.co.uk
MAIL_FROM_NAME="Prescribe & Co"

# ── Stripe (for webhook reconciliation only) ─────────────────────────────────
STRIPE_KEY=pk_live_
STRIPE_SECRET=sk_live_
STRIPE_WEBHOOK_SECRET=whsec_

# ── CRM-specific ──────────────────────────────────────────────────────────────
# Comma-separated IPs or CIDR ranges. At least one required or all access denied.
CRM_IP_WHITELIST=127.0.0.1

# Pharmacy details printed on prescription PDFs and dispensing labels
PHARMACY_NAME="Prescribe & Co"
PHARMACY_ADDRESS="Your Registered Pharmacy Address, UK"
PHARMACY_GPHC_NUMBER=
PHARMACY_PHONE=
PHARMACY_EMAIL=pharmacy@prescribeandco.co.uk

# Signature storage disk (local = private storage, no third-party service)
SIGNATURE_STORAGE_DISK=local

# Initial Super Admin (used by StaffSeeder only — change after first login)
SUPER_ADMIN_EMAIL=admin@prescribeandco.co.uk
SUPER_ADMIN_PASSWORD=

# ── Storage ───────────────────────────────────────────────────────────────────
FILESYSTEM_DISK=local

# ── Security ──────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12

# Hours outside which logins are flagged as suspicious (SuspiciousLoginDetector)
CRM_SUSPICIOUS_LOGIN_HOURS_START=7
CRM_SUSPICIOUS_LOGIN_HOURS_END=22
